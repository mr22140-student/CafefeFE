{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lanzarBrowserSync",
      "command": "browser-sync start --server src -f \"**/*\" ./src/ --no-open",
      "type": "shell",
      "presentation": {
        "reveal": "silent"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "browsersync",
        "pattern": {
          "regexp": "^__sin_errores__$"
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "\\[Browsersync\\]",
          "endsPattern": "Serving files from"
        }
      }
    },
    {
      "label": "debugBrowserSync",
      "command": "browser-sync start --server ./ -f \"**/*\" ./ --no-open",
      "type": "shell",
      "presentation": {
        "reveal": "silent"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "browsersync",
        "pattern": {
          "regexp": "^__sin_errores__$"
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "\\[Browsersync\\]",
          "endsPattern": "Serving files from"
        }
      }
    },
    {
      "label": "matarBrowserSync",
      "type": "shell",
      "command": "echo ${input:terminate}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}
